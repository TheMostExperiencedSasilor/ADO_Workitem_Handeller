# Azure DevOps
# ADO PAT is entered in Setup and kept in process memory only; do not add ADO_PAT here.
ADO_ORGANIZATION=your-ado-organization
ADO_PROJECT=your-ado-project
ADO_API_VERSION=7.1

# Copilot is connected from Setup with a session-only GitHub PAT.
# Do not store Copilot credentials here.

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true
